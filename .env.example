# ---------------------------------------------------------------------------
# Celestial English Golden Retrievers — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# Generate a strong secret:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Payload secret — used to sign tokens. MUST be long & random. CHANGE THIS.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string.
# In Docker Compose, host is the service name `db`.
DATABASE_URI=postgres://breeder:change-me-db-password@db:5432/breeder

# Public URL of the site (used for emails, sitemap, OG, CORS, CSRF).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database (used by docker-compose to provision Postgres) ---------------
POSTGRES_DB=breeder
POSTGRES_USER=breeder
POSTGRES_PASSWORD=change-me-db-password

# --- Deployment / Caddy ----------------------------------------------------
# Domain Caddy serves HTTPS for. Use `localhost` for local testing.
SITE_DOMAIN=localhost
# Email Caddy/Let's Encrypt uses for certificate notices.
CADDY_TLS_EMAIL=admin@example.com

# --- Email (optional; SMTP). Leave blank to disable (logs to console). -----
# Works with any SMTP provider, including Resend (host: smtp.resend.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From + to addresses for transactional mail.
EMAIL_FROM="Celestial English Golden Retrievers <no-reply@example.com>"
EMAIL_TO_BREEDER=pamela@example.com

# --- Stripe (optional). Leave blank to disable deposit links. --------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- S3-compatible storage (optional). Leave blank to use local volume. ----
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true for providers that require path-style URLs (e.g. MinIO).
S3_FORCE_PATH_STYLE=false

# --- Local uploads (when S3 is disabled) -----------------------------------
# Directory for locally-stored images/PDFs. In Docker this is a mounted volume.
UPLOADS_DIR=./uploads

# --- SEO (optional) ---------------------------------------------------------
# Google Search Console ownership token (Settings -> Ownership verification ->
# HTML tag; paste only the content="..." value).
GOOGLE_SITE_VERIFICATION=

# --- Seeding (optional) ----------------------------------------------------
# First admin user created by `npm run seed`. Change before production.
SEED_ADMIN_EMAIL=pamela@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
