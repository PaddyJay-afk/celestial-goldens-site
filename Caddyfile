# Caddy reverse proxy with automatic HTTPS.
# {$SITE_DOMAIN} and {$CADDY_TLS_EMAIL} come from the environment (see .env).
{
	# Use a contact email for Let's Encrypt notices when provided.
	email {$CADDY_TLS_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Proxy everything to the Next.js app.
	#
	# Caddy replaces any client-supplied X-Forwarded-For with the real peer
	# address, because no `trusted_proxies` is configured here — so a bot cannot
	# forge an IP to get itself a fresh rate-limit bucket. Do not add
	# `trusted_proxies` without also setting TRUSTED_PROXY_HOPS on the app (see
	# src/lib/rate-limit.ts): trusting a proxy makes Caddy *append* rather than
	# replace, and the left-most entry becomes attacker-controlled again.
	reverse_proxy app:3000 {
		# Caddy does not set X-Real-IP on its own; the app uses it as a fallback.
		header_up X-Real-IP {remote_host}
	}

	# Security headers (complement those set in next.config.mjs).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Don't advertise the proxy in responses.
		-Server
	}

	# Cache Next.js static assets and served uploads aggressively.
	@static path /_next/static/* /favicon.svg /api/media/file/* /api/documents/file/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
